# docs/options.md: every option of the guest and build-host modules,
# rendered from their descriptions. `nix run .#options-doc` writes it.
{
  pkgs,
  nixpkgs,
  self,
}: let
  eval = nixpkgs.lib.nixosSystem {
    modules = [
      self.nixosModules.guest
      self.nixosModules.buildHost
      {nixpkgs.hostPlatform = "aarch64-linux";}
    ];
  };
  doc = pkgs.nixosOptionsDoc {
    options = {inherit (eval.options) pocketnix;};
    # They're store paths, whose hash changes with every commit.
    transformOptions = opt: opt // {declarations = [];};
  };
in
  pkgs.runCommand "pocketnix-options.md" {} ''
    cat > $out <<'EOF'
    # Options

    <!-- Generated by `nix run .#options-doc` from the options' descriptions in nix/: edit those. -->

    Every option of `nixosModules.guest` and `nixosModules.buildHost`.
    [Configuration](configuration.md) explains them by topic.

    EOF
    cat ${doc.optionsCommonMark} >> $out
    # A default that evaluates to a package renders its store path, which changes with nixpkgs.
    if grep -n /nix/store $out; then
      echo "a store path in docs/options.md: give that option a defaultText" >&2
      exit 1
    fi
  ''
